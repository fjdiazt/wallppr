<Window x:Class="Wallppr.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wallppr settings"
        Icon="/Assets/wallppr.ico"
        Width="620"
        Height="500"
        MinWidth="520"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="13" Background="#30384B" BorderBrush="#49536A" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3" HorizontalAlignment="Left" Fill="#E8ECF5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#C4B5FD" />
                                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="30,26,30,22" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" />
                <TextBlock Margin="0,6,0,0" Text="Global Wallppr behavior." Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="30,26" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="STARTUP &amp; BACKGROUND" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" />
                <Border Margin="0,10,0,0" Padding="20,4" CornerRadius="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Start Wallppr with Windows" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" Text="Launch for your account when you sign in." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding StartWithWindows, Mode=OneWay}" Click="StartWithWindows_Click" AutomationProperties.Name="Start Wallppr with Windows" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" />

                        <Grid Margin="0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Minimize to notification area" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" Text="Hide the window when minimized." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding MinimizeToTray, Mode=OneWay}" Click="MinimizeToTray_Click" AutomationProperties.Name="Minimize to notification area" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" />

                        <Grid Margin="0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Keep running when closed" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0" Text="The close button hides Wallppr in the notification area." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding CloseToTray, Mode=OneWay}" Click="CloseToTray_Click" AutomationProperties.Name="Keep Wallppr running when closed" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="30,14" Background="#0D1018" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="Settings save immediately" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                <TextBlock x:Name="StatusText" HorizontalAlignment="Right" Foreground="#A7F3D0" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
