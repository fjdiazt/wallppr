<Window x:Class="Wallppr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wallppr"
        mc:Ignorable="d"
        Title="wallppr"
        Icon="/Assets/wallppr.ico"
        Width="1540"
        Height="840"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="34,28,34,24" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="wallppr" FontSize="30" FontWeight="Bold" />
                        <Border Margin="13,2,0,0" Padding="9,4" VerticalAlignment="Center" CornerRadius="12" Background="#25203F" BorderBrush="#59459A" BorderThickness="1">
                            <TextBlock Text="POC" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,7,0,0" Text="Wallpaper, monitor by monitor." Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RefreshButton" Margin="0,0,10,0" Style="{StaticResource BaseButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="Refresh displays">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" FontSize="18" Margin="0,-3,8,-1" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButtonStyle}" Click="Settings_Click" AutomationProperties.Name="Open settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DisplayCountText" Margin="0,9,0,0" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="StatusBanner" Grid.Row="1" Margin="34,18,34,0" Padding="14,10" CornerRadius="10" Background="#172033" BorderBrush="#2D3E62" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="#C7D2FE" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer Margin="34,22,16,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Monitors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:MonitorCardViewModel}">
                        <Border Width="342" Margin="0,0,18,18" Padding="18" CornerRadius="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.25" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="160" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="2,0,2,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Resolution}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,5" CornerRadius="12" VerticalAlignment="Top" Background="#20283A">
                                        <TextBlock Text="{Binding Orientation}" Foreground="#B7C3D9" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Margin="2,0,2,14" Padding="3" CornerRadius="11" Background="#0E121B" BorderBrush="#252D40" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" Style="{StaticResource SegmentToggleStyle}" IsChecked="{Binding IsImageSource, Mode=OneWay}" Click="ImageSource_Click" Content="Image" AutomationProperties.Name="Use image source" />
                                        <ToggleButton Grid.Column="1" Style="{StaticResource SegmentToggleStyle}" IsChecked="{Binding IsFolderSource, Mode=OneWay}" Click="FolderSource_Click" Content="Folder" AutomationProperties.Name="Use folder source" />
                                    </Grid>
                                </Border>

                                <Button Grid.Row="2" Style="{StaticResource PreviewButtonStyle}" Click="Preview_Click" ToolTip="{Binding PreviewActionText}" AutomationProperties.Name="{Binding PreviewActionText}">
                                    <Grid>
                                        <Grid Visibility="{Binding IsImageSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#465066" FontSize="11" FontWeight="Bold" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" AutomationProperties.Name="Wallpaper preview" />
                                            <Border VerticalAlignment="Bottom" Height="54">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="#C9000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <Grid Visibility="{Binding IsFolderSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding HasFolderImage, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Folder wallpaper preview" />
                                            <Border VerticalAlignment="Bottom" Height="54" Visibility="{Binding HasFolderImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                        <GradientStop Color="#00000000" Offset="0" />
                                                        <GradientStop Color="#C9000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoFolderImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="&#xE8B7;" HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="#A78BFA" />
                                                <TextBlock Margin="0,10,0,0" Text="SLIDESHOW FOLDER" HorizontalAlignment="Center" Foreground="#66728A" FontSize="10" FontWeight="Bold" />
                                                <TextBlock Margin="16,5" Text="{Binding FolderName}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Height="4" Margin="24,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsThumbnailLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>

                                <Grid Grid.Row="3" Margin="2,13,2,14">
                                    <StackPanel Visibility="{Binding IsImageSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="SELECTED IMAGE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding FileName}" ToolTip="{Binding PreviewPath}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsFolderSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="CURRENT IMAGE" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding FolderImageName}" ToolTip="{Binding FolderPreviewPath}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding SlideshowFolderPath, TargetNullValue=Choose a folder}" ToolTip="{Binding SlideshowFolderPath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Button Visibility="{Binding IsImageSource, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource PrimaryButtonStyle}" Click="Choose_Click" Content="Choose image" AutomationProperties.Name="Choose and apply wallpaper image" />
                                    <StackPanel Visibility="{Binding IsFolderSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource BaseButtonStyle}" Click="ChooseFolder_Click" Content="Choose folder" AutomationProperties.Name="Choose slideshow folder" />
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="NextFolderImage_Click" Content="Next" IsEnabled="{Binding HasFolderImage}" AutomationProperties.Name="Apply next folder image" />
                                        </Grid>
                                        <TextBlock Margin="2,14,0,7" Text="ORDER" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" />
                                        <Border Padding="3" CornerRadius="11" Background="#0E121B" BorderBrush="#252D40" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0" Style="{StaticResource SegmentToggleStyle}" IsChecked="{Binding IsSequentialOrder, Mode=OneWay}" Click="SequentialOrder_Click" Content="Sequential" AutomationProperties.Name="Sequential slideshow order" />
                                                <ToggleButton Grid.Column="1" Style="{StaticResource SegmentToggleStyle}" IsChecked="{Binding IsRandomOrder, Mode=OneWay}" Click="RandomOrder_Click" Content="Random" AutomationProperties.Name="Random slideshow order" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <Border x:Name="LoadingOverlay" Background="#D90A0C12" Visibility="Collapsed" AutomationProperties.Name="Loading displays">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE895;" HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="#A78BFA" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Margin="0,14,0,0" Text="Loading displays…" Foreground="{StaticResource MutedTextBrush}" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="34,12" Background="#0D1018" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="Native Windows wallpaper API" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                <TextBlock x:Name="SlideshowStatusText" HorizontalAlignment="Right" Text="Slideshow off" Foreground="#69758B" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
